# Application
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=gt_vehicle
DB_PASSWORD=gt_vehicle_secret
DB_DATABASE=gt_vehicle_db
DB_SSL=false
DB_LOGGING=true
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Internal Gateway Auth (shared secret with API Gateway)
INTERNAL_GATEWAY_TOKEN=change-me-gateway-secret-min-32-chars

# RBAC Service (for permission resolution)
RBAC_SERVICE_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGINS=http://localhost:4200

# Logging
LOG_LEVEL=debug
